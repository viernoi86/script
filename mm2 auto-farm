local Players = game:GetService("Players")

local player = Players.LocalPlayer

--------------------------------------------------
-- CONFIGURATION
--------------------------------------------------

local SPEED = 23
local SEARCH_RADIUS = 200

--------------------------------------------------
-- GUI
--------------------------------------------------

local gui = Instance.new("ScreenGui")
gui.Name = "AutoCoinGUI"
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")

local button = Instance.new("TextButton")
button.Name = "AutoCoinButton"
button.Size = UDim2.fromOffset(190, 50)
button.Position = UDim2.new(0, 20, 0.5, -25)

button.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
button.TextColor3 = Color3.fromRGB(255, 255, 255)

button.Text = "Auto Coin : OFF"
button.TextSize = 18
button.Font = Enum.Font.GothamBold

button.Parent = gui

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 10)
corner.Parent = button

--------------------------------------------------
-- VARIABLES
--------------------------------------------------

local enabled = false
local collected = {}

--------------------------------------------------
-- CHARACTER
--------------------------------------------------

local function getCharacter()
	local character = player.Character

	if not character then
		character = player.CharacterAdded:Wait()
	end

	return character
end

local function getRoot()
	local character = getCharacter()

	return character:FindFirstChild("HumanoidRootPart")
		or character.PrimaryPart
end

--------------------------------------------------
-- DÉTECTION AUTOMATIQUE DES COIN CONTAINERS
--------------------------------------------------

local function getCoinContainers()

	local containers = {}

	for _, object in ipairs(workspace:GetDescendants()) do

		if object.Name == "CoinContainer" then

			local hasCoins = false

			for _, descendant in ipairs(object:GetDescendants()) do

				if descendant.Name == "Coin_Server" then
					hasCoins = true
					break
				end

			end

			if hasCoins then
				table.insert(containers, object)
			end
		end
	end

	return containers
end

--------------------------------------------------
-- POSITION D'UNE COIN
--------------------------------------------------

local function getCoinPosition(coin)

	-- Si Coin_Server est directement une Part
	if coin:IsA("BasePart") then
		return coin.Position
	end

	-- Si Coin_Server est un Model
	if coin:IsA("Model") then

		local success, pivot = pcall(function()
			return coin:GetPivot()
		end)

		if success and pivot then
			return pivot.Position
		end
	end

	-- Sinon cherche une Part à l'intérieur
	local part = coin:FindFirstChildWhichIsA(
		"BasePart",
		true
	)

	if part then
		return part.Position
	end

	return nil
end

--------------------------------------------------
-- CHERCHE LA COIN LA PLUS PROCHE
--------------------------------------------------

local function getNearestCoin()

	local root = getRoot()

	if not root then
		return nil
	end

	local nearest = nil
	local nearestDistance = SEARCH_RADIUS

	-- Recherche automatique de toutes les maps
	-- contenant un CoinContainer
	local containers = getCoinContainers()

	for _, container in ipairs(containers) do

		for _, coin in ipairs(container:GetDescendants()) do

			if coin.Name == "Coin_Server"
				and not collected[coin]
				and coin.Parent then

				local position = getCoinPosition(coin)

				if position then

					local distance =
						(root.Position - position).Magnitude

					if distance < nearestDistance then

						nearestDistance = distance
						nearest = coin

					end
				end
			end
		end
	end

	return nearest
end

--------------------------------------------------
-- DÉPLACEMENT VERS LA COIN
--------------------------------------------------

local function moveToCoin(coin)

	if not coin or not coin.Parent then
		return
	end

	local character = getCharacter()
	local root = getRoot()

	if not root then
		return
	end

	local targetPosition = getCoinPosition(coin)

	if not targetPosition then
		return
	end

	local distance =
		(root.Position - targetPosition).Magnitude

	local duration =
		math.max(distance / SPEED, 0.05)

	local startPosition = root.Position
	local startTime = os.clock()

	--------------------------------------------------
	-- Mouvement progressif
	--------------------------------------------------

	while enabled and coin.Parent do

		root = getRoot()

		if not root then
			break
		end

		local elapsed =
			os.clock() - startTime

		local alpha =
			math.clamp(
				elapsed / duration,
				0,
				1
			)

		local position =
			startPosition:Lerp(
				targetPosition,
				alpha
			)

		character:PivotTo(
			CFrame.new(position)
		)

		if alpha >= 1 then
			break
		end

		task.wait()
	end

	-- Empêche de sélectionner immédiatement
	-- la même coin
	collected[coin] = true

end

--------------------------------------------------
-- NETTOYAGE
--------------------------------------------------

local function cleanCollected()

	for coin in pairs(collected) do

		if not coin.Parent then
			collected[coin] = nil
		end

	end

end

--------------------------------------------------
-- AUTO COIN
--------------------------------------------------

local function autoCoinLoop()

	while enabled do

		cleanCollected()

		local coin = getNearestCoin()

		if coin then

			moveToCoin(coin)

			task.wait(0.1)

		else

			-- Aucune coin trouvée pour le moment
			task.wait(0.5)

		end
	end
end

--------------------------------------------------
-- BOUTON
--------------------------------------------------

local function updateButton()

	if enabled then

		button.Text = "Auto Coin : ON"

		button.BackgroundColor3 =
			Color3.fromRGB(45, 180, 75)

	else

		button.Text = "Auto Coin : OFF"

		button.BackgroundColor3 =
			Color3.fromRGB(35, 35, 35)

	end

end

button.MouseButton1Click:Connect(function()

	enabled = not enabled

	updateButton()

	if enabled then
		task.spawn(autoCoinLoop)
	end

end)

--------------------------------------------------
-- RESPAWN
--------------------------------------------------

player.CharacterAdded:Connect(function()

	-- On vide les anciennes références
	-- après un respawn.
	table.clear(collected)

end)

updateButton()
